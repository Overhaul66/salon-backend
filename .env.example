# Django Settings
SECRET_KEY=django-insecure-%_aijh#dbhvhuzm5!9+1!!tnqjzgg9k-a)i6zi+r#y57c=49g%
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
# Set this to connect to PostgreSQL. If left empty or unset, SQLite will be used.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/salon_db

# Celery & Redis Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==========================================
# Production (Render) Settings
# ==========================================
# These are set as env vars in the Render dashboard / render.yaml.
# Real environment variables always take priority over this file.

# SECRET_KEY=generate-a-long-random-string
# DEBUG=False
# ALLOWED_HOSTS=salon-api.onrender.com,localhost

# Media files storage (local disk on Render)
# MEDIA_ROOT=/var/data/media

# Optional: use an S3-compatible bucket instead of the Render disk
# (works with MinIO, Cloudflare R2, Backblaze B2, AWS S3, etc.)
# USE_MINIO=True
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_ENDPOINT_URL=https://your-s3-provider.example
# AWS_S3_REGION_NAME=auto
# AWS_S3_USE_SSL=True
# AWS_S3_CUSTOM_DOMAIN=your-bucket.your-s3-provider.example
