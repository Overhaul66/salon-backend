# Django Settings
SECRET_KEY=django-insecure-%_aijh#dbhvhuzm5!9+1!!tnqjzgg9k-a)i6zi+r#y57c=49g%
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
# Set this to connect to PostgreSQL. If left empty or unset, SQLite will be used.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/salon_db

# Celery & Redis Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==========================================
# AWS S3 Storage (django-storages + boto3)
# ==========================================
# All uploaded media (profile pictures, salon logos/covers/gallery) is stored in
# your S3 bucket. Values are read from real environment variables first
# (Render/Heroku), then from this file. Do NOT commit real credentials here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-north-1

# ==========================================
# Production (Render) Settings
# ==========================================
# These are set as env vars in the Render dashboard / render.yaml.
# Real environment variables always take priority over this file.

# SECRET_KEY=generate-a-long-random-string
# DEBUG=False
# ALLOWED_HOSTS=salon-api.onrender.com,localhost

# Media files storage (local disk on Render, only used as a fallback when no
# S3 bucket is configured)
# MEDIA_ROOT=/var/data/media

# Uploaded images are stored in AWS S3 via django-storages + boto3
# (see apps.common.fields.Base64ImageField). Set AWS_STORAGE_BUCKET_NAME plus
# the AWS credentials above to enable S3; otherwise local filesystem is used.
