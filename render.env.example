# Render environment reference — copy these values into the Render dashboard
# (Service -> Environment). NOTE: Render does not read this file at runtime;
# set each key as an env var on the service.

SECRET_KEY=<your-long-random-secret>
DEBUG=False
ALLOWED_HOSTS=your-service-name.onrender.com

# Render Postgres — paste the INTERNAL connection string here (starts with postgres://)
DATABASE_URL=postgres://user:password@host:5432/salon_db

# ==========================================
# AWS S3 Storage (django-storages + boto3)
# ==========================================
# Uploaded images (profile pictures, salon logos/covers/gallery) are stored in
# your S3 bucket. Paste your real values into the Render dashboard - never
# commit real credentials to this file.
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_STORAGE_BUCKET_NAME=<your-bucket-name>
AWS_S3_REGION_NAME=eu-north-1
